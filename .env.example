# Copy this file to .env and fill in your values
# NEVER commit .env to git

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_GOOGLE_MAPS_API_KEY=""

# PostHog analytics + session replay
VITE_POSTHOG_PROJECT_TOKEN=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
# Numeric PostHog project id, used to deep-link admins to a user's recordings.
# Find it in the PostHog app URL: /project/<ID>/... Leave blank to hide the link.
VITE_POSTHOG_PROJECT_ID=""
# PostHog app host for the admin deep-link (defaults to https://us.posthog.com)
VITE_POSTHOG_APP_HOST="https://us.posthog.com"

# Supabase Edge Function secrets (set with Supabase, not Vite)
STRIPE_TOPUP_PRICE_STARTER=""
STRIPE_TOPUP_PRICE_GROWTH=""
STRIPE_TOPUP_PRICE_PRO=""
STRIPE_SUBSCRIPTION_PRICE_STARTER=""
STRIPE_SUBSCRIPTION_PRICE_GROWTH=""
STRIPE_SUBSCRIPTION_PRICE_PRO=""
