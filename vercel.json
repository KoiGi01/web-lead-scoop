{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.globaleads22.com" }],
      "destination": "/index.html"
    },
    { "source": "/app",     "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms",   "destination": "/index.html" },
    { "source": "/",        "destination": "/landing.html" }
  ]
}
