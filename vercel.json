{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "globaleads22.com" }],
      "destination": "https://www.globaleads22.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.globaleads22.com" }],
      "destination": "/index.html"
    },
    { "source": "/app",     "destination": "/index.html" },
    { "source": "/demo",    "destination": "/index.html" },
    { "source": "/preview/:token", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms",   "destination": "/index.html" },
    { "source": "/",        "destination": "/landing.html" }
  ]
}
